# Copy to .env and fill in real values. .env is gitignored; loaded automatically by
# tests/conftest.py (python-dotenv) when running `pytest`/`uv run pytest` locally.
#
# Used by target_bigquery/tests/test_core.py, test_sync.py, and test_utils.py's live
# BigQuery integration tests.

# A GCP project to run the integration tests against.
BQ_PROJECT=my-gcp-project

# A BigQuery dataset in BQ_PROJECT the tests are free to create/drop tables in.
BQ_DATASET=target_bigquery_tests

# The contents of a service account JSON key file, as a single-line string, with
# "roles/bigquery.dataEditor" and "roles/bigquery.jobUser" (or broader) on BQ_PROJECT.
BQ_CREDS={"type": "service_account", "project_id": "my-gcp-project", ...}

# A GCS bucket used by the gcs_stage method's tests.
GCS_BUCKET=my-gcs-bucket
